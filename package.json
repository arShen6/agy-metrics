  "description": "See token usage, context fill and generation speed inside Antigravity. 查看 token 用量、上下文占用与生成速度。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "tokens-tips": "bin/agy-metrics.mjs"
  },
