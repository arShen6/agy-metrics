    "release:build": "python3 scripts/build_release.py"
  },
  "files": [
    "bin/",
    "src/",
    "ui/",
    "demo/",
    "docs/",
    "start.command",
    "start.sh",
    "start.cmd",
    "install.command",
    "install-zh.command",
    "install-en.command",
    "uninstall.command",
    "status.command",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "assets/"
  ],
  "repository": {
    "type": "git",
